if(NOT PATTERN)
  set(PATTERN "*.slang")
endif()
if(NOT NAMESPACE)
  set(NAMESPACE "vtkSlangSources")
endif()

set(_chunk 8000)

file(GLOB SHADER_FILES "${SHADER_DIR}/${PATTERN}")
list(SORT SHADER_FILES)

set(CONTENT "// AUTO-GENERATED by EmbedShaders.cmake — do not edit.\n")
string(APPEND CONTENT "#pragma once\n\n")
string(APPEND CONTENT "#include <string_view>\n\n")
string(APPEND CONTENT "// Shader sources (${PATTERN}) embedded at build time.\n")
string(APPEND CONTENT "// Access via ${NAMESPACE}::get(\"name\").\n\n")
string(APPEND CONTENT "namespace ${NAMESPACE} {\n\n")

foreach(FILE ${SHADER_FILES})
  get_filename_component(NAME_WE "${FILE}" NAME_WE)
  file(READ "${FILE}" SRC)
  string(LENGTH "${SRC}" _len)
  string(APPEND CONTENT "static const char* const k_${NAME_WE} =\n")
  set(_pos 0)
  while(_pos LESS _len)
    string(SUBSTRING "${SRC}" ${_pos} ${_chunk} _piece)
    string(APPEND CONTENT "R\"SHADER(${_piece})SHADER\"\n")
    math(EXPR _pos "${_pos} + ${_chunk}")
  endwhile()
  string(APPEND CONTENT ";\n\n")
endforeach()

string(APPEND CONTENT "// Look up a shader source by file name without extension (e.g. \"pbr\").\n")
string(APPEND CONTENT "inline const char* get(std::string_view name) {\n")

foreach(FILE ${SHADER_FILES})
  get_filename_component(NAME_WE "${FILE}" NAME_WE)
  string(APPEND CONTENT "  if (name == \"${NAME_WE}\") return k_${NAME_WE};\n")
endforeach()

string(APPEND CONTENT "  return nullptr;\n}\n\n")
string(APPEND CONTENT "} // namespace ${NAMESPACE}\n")

file(WRITE "${OUT_HEADER}" "${CONTENT}")
